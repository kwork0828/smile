   "id": 75,
   "sec": "S7 행동 요청과 마무리",
   "start": 262.6,
   "end": 265.6,
   "text": "선하게 쓰이는 도구가 될 수 있도록,"
  },
  {
   "id": 76,
   "sec": "S7 행동 요청과 마무리",
   "start": 265.6,
   "end": 269.2,
   "text": "저도 그 책임을 기억하며 만들어 가겠습니다."
