 ],
 "chunks": [
  {
   "id": 1,
   "sec": "S1 첫 질문 — AI 포모의 공감",
   "start": 0.0,
   "end": 2.1,
   "text": "AI가 무서웠습니다."
  },
  {
   "id": 2,
   "sec": "S1 첫 질문 — AI 포모의 공감",
   "start": 2.1,
   "end": 6.0,
   "text": "SNS를 열 때마다 업데이트 소식은 너무 빠르고,"
  },
  {
   "id": 3,
   "sec": "S1 첫 질문 — AI 포모의 공감",
   "start": 6.0,
   "end": 9.0,
   "text": "주변은 다 AI 고수처럼 보였는데,"
  },
  {
   "id": 4,
   "sec": "S1 첫 질문 — AI 포모의 공감",
   "start": 9.0,
   "end": 12.4,
   "text": "저는 아직 제대로 해본 게 없는 것 같았어요."
  },
  {
   "id": 5,
   "sec": "S1 첫 질문 — AI 포모의 공감",
   "start": 12.4,
   "end": 15.4,
   "text": "'나만 뒤쳐지고 있는 건 아닐까?'"
  },
  {
   "id": 6,
   "sec": "S1 첫 질문 — AI 포모의 공감",
   "start": 15.4,
   "end": 18.3,
   "text": "그 포모가 꽤 오래 저를 눌렀습니다."
  },
  {
   "id": 7,
   "sec": "S2 실제로 막혔던 순간",
   "start": 18.3,
   "end": 21.6,
   "text": "처음에는 설치 하나도 쉽지 않았습니다."
  },
  {
   "id": 8,
   "sec": "S2 실제로 막혔던 순간",
   "start": 21.6,
   "end": 25.7,
   "text": "터미널 창만 열리면 괜히 잘못 건드릴까 봐 긴장했고,"
  },
  {
   "id": 9,
   "sec": "S2 실제로 막혔던 순간",
   "start": 25.7,
   "end": 28.0,
   "text": "디스코드 하나 설치할 때도"
  },
  {
   "id": 10,
   "sec": "S2 실제로 막혔던 순간",
   "start": 28.0,
   "end": 31.4,
   "text": "인증 오류가 반복돼서 그냥 포기했었어요."
  },
  {
   "id": 11,
   "sec": "S2 실제로 막혔던 순간",
   "start": 31.4,
   "end": 35.6,
   "text": "AI가 뭔가 만들어줘도, 내가 한 것 같지 않은 느낌."
  },
  {
   "id": 12,
   "sec": "S2 실제로 막혔던 순간",
   "start": 35.6,
   "end": 38.0,
   "text": "그 괴리감이 제일 컸습니다."
  },
  {
   "id": 13,
   "sec": "S2 실제로 막혔던 순간",
   "start": 38.0,
   "end": 42.5,
   "text": "그런데 돌아보면, 문제는 실력이 아니라 방향이었어요."
  },
  {
   "id": 14,
   "sec": "S2 실제로 막혔던 순간",
   "start": 42.5,
   "end": 46.5,
   "text": "예제만 따라 하니까 이틀이면 흥미가 식더라고요."
  },
  {
   "id": 15,
   "sec": "S2 실제로 막혔던 순간",
   "start": 46.5,
   "end": 50.4,
   "text": "스탑워치 만들고, 간단한 웹사이트 만들고..."
  },
  {
   "id": 16,
   "sec": "S2 실제로 막혔던 순간",
   "start": 50.4,
   "end": 53.0,
   "text": "신기하지만 지속이 안 됐어요."
  },
  {
   "id": 17,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 53.0,
   "end": 57.2,
   "text": "그럼 어떻게 하면 AI 사용에 익숙해질 수 있을까요?"
  },
  {
   "id": 18,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 57.2,
   "end": 60.8,
   "text": "제가 겪으면서 찾은 방법, 셋을 나눠볼게요."
  },
  {
   "id": 19,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 60.8,
   "end": 64.8,
   "text": "첫째, 내 삶에 실제로 필요한 것부터 찾았습니다."
  },
  {
   "id": 20,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 64.8,
   "end": 68.7,
   "text": "취업·이직 서비스, 아이 양육을 도와주는 챗봇,"
  },
  {
   "id": 21,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 68.7,
   "end": 70.6,
   "text": "직장 근태 관리 도구."
  },
  {
   "id": 22,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 70.6,
   "end": 74.6,
   "text": "예제가 아니라 내 문제를 풀어야 계속하게 됐어요."
  },
  {
   "id": 23,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 74.6,
   "end": 78.0,
   "text": "둘째, 강제성 있는 환경을 세팅했습니다."
  },
  {
   "id": 24,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 78.0,
   "end": 82.9,
   "text": "처음엔 혼자 하면 며칠 안 돼서 원래 방식으로 돌아가더라고요."
  },
  {
   "id": 25,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 82.9,
   "end": 87.2,
   "text": "그래서 과제를 제출해야 할인받는 챌린지에 참여하고,"
  },
  {
   "id": 26,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 87.2,
   "end": 90.8,
   "text": "젠스파크도 해보고, 바이브코딩도 해보고,"
  },
  {
   "id": 27,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 90.8,
   "end": 93.8,
   "text": "나중엔 직장인도 무료로 들을 수 있는"
  },
  {
   "id": 28,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 93.8,
   "end": 96.5,
   "text": "AI 부트캠프까지 참여했어요."
  },
  {
   "id": 29,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 96.5,
   "end": 100.7,
   "text": "관련 정보는 나중에 따로 영상 만들어서 공유할게요."
  },
  {
   "id": 30,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 100.7,
   "end": 104.6,
   "text": "셋째, 꾸준히 할 수 있는 시간대를 만들었습니다."
  },
  {
   "id": 31,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 104.6,
   "end": 109.0,
   "text": "저는 일도 하고 육아도 하다 보니 시간이 정말 안 났어요."
  },
  {
   "id": 32,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 109.0,
   "end": 111.9,
   "text": "그래서 주로 새벽에 작업했습니다."
  },
  {
   "id": 33,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 111.9,
   "end": 114.7,
   "text": "맥도날드 24시간 DT점이나,"
  },
  {
   "id": 34,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 114.7,
   "end": 117.8,
   "text": "사람 적고 깔끔한 PC방을 찾아서요."
  },
  {
   "id": 35,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 117.8,
   "end": 122.1,
   "text": "처음엔 어렵더라도, 여러 번 하다 보면 익숙해집니다."
  },
  {
   "id": 36,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 122.1,
   "end": 124.2,
   "text": "쉬운 것부터 시작해서,"
  },
  {
   "id": 37,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 124.2,
   "end": 128.5,
   "text": "한 번의 어려움을 넘기면 다음엔 조금 더 자신이 생겨요."
  },
  {
   "id": 38,
   "sec": "S3 익숙해지는 세 가지 방법",
   "start": 128.5,
   "end": 133.0,
   "text": "무료 자료도 많아요. 이동 시간을 활용해도 충분합니다."
  },
  {
   "id": 39,
   "sec": "S4 변화의 증거 — '아직 낯선 것뿐'",
   "start": 133.0,
   "end": 136.6,
   "text": "그렇게 반복하니까, 조금씩 달라졌습니다."
  },
  {
   "id": 40,
   "sec": "S4 변화의 증거 — '아직 낯선 것뿐'",
   "start": 136.6,
   "end": 139.9,
   "text": "터미널 까만 화면이 조금 덜 낯설어졌고,"
  },
  {
   "id": 41,
   "sec": "S4 변화의 증거 — '아직 낯선 것뿐'",
   "start": 139.9,
   "end": 144.3,
   "text": "도구와 도구를 연결하는 일도 하나씩 시도해 보게 됐어요."
  },
  {
   "id": 42,
   "sec": "S4 변화의 증거 — '아직 낯선 것뿐'",
   "start": 144.3,
   "end": 148.7,
   "text": "어떤 분이 말씀해 주셨어요. \"새로운 걸 배울 때,"
  },
  {
   "id": 43,
   "sec": "S4 변화의 증거 — '아직 낯선 것뿐'",
   "start": 148.7,
   "end": 152.6,
   "text": "'아직 낯설어서 그런 것뿐이다'라고 생각하고,"
  },
  {
   "id": 44,
   "sec": "S4 변화의 증거 — '아직 낯선 것뿐'",
   "start": 152.6,
   "end": 157.8,
   "text": "가장 쉬운 것부터 해나간다\"고요. 그 말이 참 와닿았습니다."
  },
  {
   "id": 45,
   "sec": "S4 변화의 증거 — '아직 낯선 것뿐'",
   "start": 157.8,
   "end": 160.9,
   "text": "'나는 원래 못 하는 사람'이 아니라,"
  },
  {
   "id": 46,
   "sec": "S4 변화의 증거 — '아직 낯선 것뿐'",
   "start": 160.9,
   "end": 165.2,
   "text": "'아직 익숙하지 않은 사람'일 뿐이라는 걸 배웠어요."
  },
  {
   "id": 47,
   "sec": "S5 두려움을 바꾸는 선택",
   "start": 165.2,
   "end": 170.4,
   "text": "그래서 저는 AI를 두려움의 이름으로만 부르지 않기로 했습니다."
  },
  {
   "id": 48,
   "sec": "S5 두려움을 바꾸는 선택",
   "start": 170.4,
   "end": 172.5,
   "text": "피할 수 없는 변화라면,"
  },
  {
   "id": 49,
   "sec": "S5 두려움을 바꾸는 선택",
   "start": 172.5,
   "end": 176.1,
   "text": "내 꿈을 이루는 도구로 한번 써 보기로 했어요."
  },
  {
   "id": 50,
   "sec": "S5 두려움을 바꾸는 선택",
   "start": 176.1,
   "end": 180.3,
   "text": "누가 더 빨리 앞서가나를 증명하기 위해서가 아니라,"
  },
  {
   "id": 51,
   "sec": "S5 두려움을 바꾸는 선택",
   "start": 180.3,
   "end": 183.2,
   "text": "내게 맡겨진 사람과 이야기와 시간을"
  },
  {
   "id": 52,
   "sec": "S5 두려움을 바꾸는 선택",
   "start": 183.2,
   "end": 185.6,
   "text": "조금 더 잘 돌보기 위해서요."
  },
  {
   "id": 53,
   "sec": "S5 두려움을 바꾸는 선택",
   "start": 185.6,
   "end": 188.7,
   "text": "AI 공부는 생각보다 늦지 않았어요."
  },
  {
   "id": 54,
   "sec": "S5 두려움을 바꾸는 선택",
   "start": 188.7,
   "end": 193.7,
   "text": "지금 이 시기가 오히려 새로운 기회가 열리는 때라는 걸 느낍니다."
  },
  {
   "id": 55,
   "sec": "S5 두려움을 바꾸는 선택",
   "start": 193.7,
   "end": 198.9,
   "text": "시작을 망설이기보다는, 하나씩 쌓아가면 그게 전문성이 됩니다."
  },
  {
   "id": 56,
   "sec": "S5 두려움을 바꾸는 선택",
   "start": 198.9,
   "end": 203.4,
   "text": "도전을 응원하지 않는 주변 반응에 흔들리지 않아도 돼요."
  },
  {
   "id": 57,
   "sec": "S6 꿈끼리가 만들고 싶은 것",
   "start": 203.4,
   "end": 205.8,
   "text": "만들고 싶은 것도 많습니다."
  },
  {
   "id": 58,
   "sec": "S6 꿈끼리가 만들고 싶은 것",
   "start": 205.8,
   "end": 209.8,
   "text": "부모님의 이야기를 따뜻하게 기록하는 다이어리,"
  },
  {
   "id": 59,
   "sec": "S6 꿈끼리가 만들고 싶은 것",
   "start": 209.8,
   "end": 212.4,
   "text": "지금 만들고 있는 성경 암송 앱,"
  },
  {
   "id": 60,
   "sec": "S6 꿈끼리가 만들고 싶은 것",
   "start": 212.4,
   "end": 215.1,
   "text": "진로와 일을 정리하는 작은 도구,"
  },
  {
   "id": 61,
   "sec": "S6 꿈끼리가 만들고 싶은 것",
   "start": 215.1,
   "end": 217.9,
   "text": "말씀을 바탕으로 한 찬양과 동화,"
  },
  {
   "id": 62,
   "sec": "S6 꿈끼리가 만들고 싶은 것",
   "start": 217.9,
   "end": 222.2,
   "text": "그리고 신앙을 오해하지 않게 도와주는 웹소설과 웹툰."
  },
  {
   "id": 63,
   "sec": "S6 꿈끼리가 만들고 싶은 것",
   "start": 222.2,
   "end": 225.3,
   "text": "유튜브도, 글도, 앱도 서로 연결하며"
  },
  {
   "id": 64,
   "sec": "S6 꿈끼리가 만들고 싶은 것",
   "start": 225.3,
   "end": 227.9,
   "text": "조금씩 확장해 가고 싶습니다."
  },
  {
   "id": 65,
   "sec": "S6 꿈끼리가 만들고 싶은 것",
   "start": 227.9,
   "end": 231.4,
   "text": "이 채널은 그 과정을 기록하는 공간입니다."
  },
  {
   "id": 66,
   "sec": "S6 꿈끼리가 만들고 싶은 것",
   "start": 231.4,
   "end": 233.8,
   "text": "완성된 것을 보여주기보다,"
  },
  {
   "id": 67,
   "sec": "S6 꿈끼리가 만들고 싶은 것",
   "start": 233.8,
   "end": 238.1,
   "text": "하나씩 시도하고, 막히고, 다시 해보는 그 과정을요."
  },
  {
   "id": 68,
   "sec": "S7 행동 요청과 마무리",
   "start": 238.1,
   "end": 242.1,
   "text": "하나씩 해보세요. 하다가 아니면, 아님 말고요."
  },
  {
   "id": 69,
   "sec": "S7 행동 요청과 마무리",
   "start": 242.1,
   "end": 246.1,
   "text": "완벽주의가 시작을 막는 가장 큰 병목이더라고요."
  },
  {
   "id": 70,
   "sec": "S7 행동 요청과 마무리",
   "start": 246.1,
   "end": 250.5,
   "text": "오늘 낯선 도구 하나 켜 보고, 내일은 조금 더 해보고."
  },
  {
   "id": 71,
   "sec": "S7 행동 요청과 마무리",
   "start": 250.5,
   "end": 253.0,
   "text": "자투리 시간도 충분합니다."
